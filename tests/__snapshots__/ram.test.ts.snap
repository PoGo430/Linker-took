// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RAM split generation > snapshots > app.ld 1`] = `
"/*
 * Linker script for partition "app" — MEMORY block only (paste into your generated linker script)
 * Generated by Linker Partition Planner.
 * FLASH: 0x08000000, 0x80000 bytes = 512 kB, dual-bank (2 × 256 kB)
 * app: 0x08008000 .. 0x0803FFFF, 0x38000 bytes = 224 kB
 * Uses bank 1 addresses (the code runs here after a bank swap too).
 * Inactive bank copy for update uploads: 0x08048000 .. 0x0807FFFF
 * RAM region "app_ram": 0x20008000 .. 0x2001DFFF, 0x16000 bytes = 88 kB
 */

MEMORY
{
  ROM (rx) : org = 0x08008000, len = 0x38000
  RAM (xrw) : org = 0x20008000, len = 0x16000
  RAM_NOINIT (xrw) : org = 0x2001E000, len = 0x2000
}

/* Partition symbols (usable from C via extern) */
PROVIDE(_bootloader_start = 0x08000000);
PROVIDE(_bootloader_size = 0x6000);
PROVIDE(_bootloader_end = 0x08006000);
PROVIDE(_header_start = 0x08006000);
PROVIDE(_header_size = 0x2000);
PROVIDE(_header_end = 0x08008000);
PROVIDE(_app_start = 0x08008000);
PROVIDE(_app_size = 0x38000);
PROVIDE(_app_end = 0x08040000);
PROVIDE(_ram_boot_ram_start = 0x20000000);
PROVIDE(_ram_boot_ram_size = 0x8000);
PROVIDE(_ram_boot_ram_end = 0x20008000);
PROVIDE(_ram_app_ram_start = 0x20008000);
PROVIDE(_ram_app_ram_size = 0x16000);
PROVIDE(_ram_app_ram_end = 0x2001E000);
PROVIDE(_ram_shared_start = 0x2001E000);
PROVIDE(_ram_shared_size = 0x2000);
PROVIDE(_ram_shared_end = 0x20020000);
"
`;

exports[`RAM split generation > snapshots > memory_map.h 1`] = `
"/*
 * memory_map.h — generated by Linker Partition Planner.
 * Single source of truth for the flash layout; include from bootloader and application.
 * *_END values are exclusive (first address after the partition).
 */
#ifndef MEMORY_MAP_H
#define MEMORY_MAP_H

#define FLASH_START                        0x08000000UL
#define FLASH_SIZE                         0x80000UL      /* 512 kB */
#define FLASH_END                          0x08080000UL
#define FLASH_PAGE_SIZE                    0x2000UL       /* 8 kB */
#define FLASH_BANK_SIZE                    0x40000UL      /* 256 kB */
#define FLASH_BANK1_START                  0x08000000UL
#define FLASH_BANK2_START                  0x08040000UL

/* bootloader — identical in both banks */
#define PART_BOOTLOADER_START              0x08000000UL
#define PART_BOOTLOADER_SIZE               0x6000UL       /* 24 kB */
#define PART_BOOTLOADER_END                0x08006000UL
#define PART_BOOTLOADER_INACTIVE_START     0x08040000UL   /* other bank, for update uploads */
#define PART_BOOTLOADER_INACTIVE_END       0x08046000UL

/* header — update target */
#define PART_HEADER_START                  0x08006000UL
#define PART_HEADER_SIZE                   0x2000UL       /* 8 kB */
#define PART_HEADER_END                    0x08008000UL
#define PART_HEADER_INACTIVE_START         0x08046000UL   /* other bank, for update uploads */
#define PART_HEADER_INACTIVE_END           0x08048000UL

/* app — update target */
#define PART_APP_START                     0x08008000UL
#define PART_APP_SIZE                      0x38000UL      /* 224 kB */
#define PART_APP_END                       0x08040000UL
#define PART_APP_INACTIVE_START            0x08048000UL   /* other bank, for update uploads */
#define PART_APP_INACTIVE_END              0x08080000UL

/* RAM */
#define RAM_START                          0x20000000UL
#define RAM_SIZE                           0x20000UL      /* 128 kB */

/* RAM region boot_ram */
#define RAM_REGION_BOOT_RAM_START          0x20000000UL
#define RAM_REGION_BOOT_RAM_SIZE           0x8000UL       /* 32 kB */
#define RAM_REGION_BOOT_RAM_END            0x20008000UL

/* RAM region app_ram */
#define RAM_REGION_APP_RAM_START           0x20008000UL
#define RAM_REGION_APP_RAM_SIZE            0x16000UL      /* 88 kB */
#define RAM_REGION_APP_RAM_END             0x2001E000UL

/* RAM region shared — shared no-init area */
#define RAM_REGION_SHARED_START            0x2001E000UL
#define RAM_REGION_SHARED_SIZE             0x2000UL       /* 8 kB */
#define RAM_REGION_SHARED_END              0x20020000UL
#define RAM_NOINIT_START                   0x2001E000UL
#define RAM_NOINIT_SIZE                    0x2000UL

#endif /* MEMORY_MAP_H */
"
`;
