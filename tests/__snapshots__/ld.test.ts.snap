exports[`linker script generation > snapshots > full template with reserved RAM 1`] = `
"/*
 * Linker script for partition "app" — complete Cortex-M template (STARTING POINT — review and adapt before use)
 * Generated by Linker Partition Planner.
 * FLASH: 0x08000000, 0x80000 bytes = 512 kB, dual-bank (2 × 256 kB)
 * app: 0x08008000 .. 0x0803FFFF, 0x38000 bytes = 224 kB
 * Uses bank 1 addresses (the code runs here after a bank swap too).
 * Inactive bank copy for update uploads: 0x08048000 .. 0x0807FFFF
 */

MEMORY
{
  ROM (rx) : org = 0x08008000, len = 0x38000
  RAM (xrw) : org = 0x20000000, len = 0x1FFF0
  RAM_NOINIT (xrw) : org = 0x2001FFF0, len = 0x10
}

/* Partition symbols (usable from C via extern) */
PROVIDE(_bootloader_start = 0x08000000);
PROVIDE(_bootloader_size = 0x6000);
PROVIDE(_bootloader_end = 0x08006000);
PROVIDE(_header_start = 0x08006000);
PROVIDE(_header_size = 0x2000);
PROVIDE(_header_end = 0x08008000);
PROVIDE(_app_start = 0x08008000);
PROVIDE(_app_size = 0x38000);
PROVIDE(_app_end = 0x08040000);

/* Entry point */
ENTRY(Reset_Handler)

/* Highest address of the user stack (top of usable RAM) */
_estack = ORIGIN(RAM) + LENGTH(RAM);

/* Minimum heap/stack; the link fails if RAM cannot hold them */
_Min_Heap_Size  = 0x200;
_Min_Stack_Size = 0x400;

SECTIONS
{
  /* Vector table first, at the start of this partition */
  .isr_vector :
  {
    . = ALIGN(4);
    KEEP(*(.isr_vector))
    . = ALIGN(4);
  } >ROM

  .text :
  {
    . = ALIGN(4);
    *(.text)
    *(.text*)
    *(.glue_7)
    *(.glue_7t)
    *(.eh_frame)
    KEEP(*(.init))
    KEEP(*(.fini))
    . = ALIGN(4);
    _etext = .;
  } >ROM

  .rodata :
  {
    . = ALIGN(4);
    *(.rodata)
    *(.rodata*)
    . = ALIGN(4);
  } >ROM

  .ARM.extab (READONLY) : { *(.ARM.extab* .gnu.linkonce.armextab.*) } >ROM
  .ARM : {
    __exidx_start = .;
    *(.ARM.exidx*)
    __exidx_end = .;
  } >ROM

  .preinit_array (READONLY) :
  {
    PROVIDE_HIDDEN(__preinit_array_start = .);
    KEEP(*(.preinit_array*))
    PROVIDE_HIDDEN(__preinit_array_end = .);
  } >ROM

  .init_array (READONLY) :
  {
    PROVIDE_HIDDEN(__init_array_start = .);
    KEEP(*(SORT(.init_array.*)))
    KEEP(*(.init_array*))
    PROVIDE_HIDDEN(__init_array_end = .);
  } >ROM

  .fini_array (READONLY) :
  {
    PROVIDE_HIDDEN(__fini_array_start = .);
    KEEP(*(SORT(.fini_array.*)))
    KEEP(*(.fini_array*))
    PROVIDE_HIDDEN(__fini_array_end = .);
  } >ROM

  /* Load address of .data in ROM, used by the startup code */
  _sidata = LOADADDR(.data);

  .data :
  {
    . = ALIGN(4);
    _sdata = .;
    *(.data)
    *(.data*)
    *(.RamFunc)
    *(.RamFunc*)
    . = ALIGN(4);
    _edata = .;
  } >RAM AT> ROM

  .bss :
  {
    . = ALIGN(4);
    _sbss = .;
    __bss_start__ = _sbss;
    *(.bss)
    *(.bss*)
    *(COMMON)
    . = ALIGN(4);
    _ebss = .;
    __bss_end__ = _ebss;
  } >RAM

  /* Shared no-init area (e.g. flags passed between bootloader and application) */
  .noinit (NOLOAD) :
  {
    . = ALIGN(4);
    KEEP(*(.noinit))
    KEEP(*(.noinit*))
    . = ALIGN(4);
  } >RAM_NOINIT

  /* Checks that heap + stack fit into RAM */
  ._user_heap_stack :
  {
    . = ALIGN(8);
    PROVIDE(end = .);
    PROVIDE(_end = .);
    . = . + _Min_Heap_Size;
    . = . + _Min_Stack_Size;
    . = ALIGN(8);
  } >RAM

  /DISCARD/ :
  {
    libc.a ( * )
    libm.a ( * )
    libgcc.a ( * )
  }

  .ARM.attributes 0 : { *(.ARM.attributes) }
}
"
`;

