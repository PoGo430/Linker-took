exports[`linker script generation > snapshots > MEMORY only, dual-bank, symbols > memory_map.h 1`] = `
"/*
 * memory_map.h — generated by Linker Partition Planner.
 * Single source of truth for the flash layout; include from bootloader and application.
 * *_END values are exclusive (first address after the partition).
 */
#ifndef MEMORY_MAP_H
#define MEMORY_MAP_H

#define FLASH_START                        0x08000000UL
#define FLASH_SIZE                         0x80000UL      /* 512 kB */
#define FLASH_END                          0x08080000UL
#define FLASH_PAGE_SIZE                    0x2000UL       /* 8 kB */
#define FLASH_BANK_SIZE                    0x40000UL      /* 256 kB */
#define FLASH_BANK1_START                  0x08000000UL
#define FLASH_BANK2_START                  0x08040000UL

/* bootloader — identical in both banks */
#define PART_BOOTLOADER_START              0x08000000UL
#define PART_BOOTLOADER_SIZE               0x6000UL       /* 24 kB */
#define PART_BOOTLOADER_END                0x08006000UL
#define PART_BOOTLOADER_INACTIVE_START     0x08040000UL   /* other bank, for update uploads */
#define PART_BOOTLOADER_INACTIVE_END       0x08046000UL

/* header — update target */
#define PART_HEADER_START                  0x08006000UL
#define PART_HEADER_SIZE                   0x2000UL       /* 8 kB */
#define PART_HEADER_END                    0x08008000UL
#define PART_HEADER_INACTIVE_START         0x08046000UL   /* other bank, for update uploads */
#define PART_HEADER_INACTIVE_END           0x08048000UL

/* app — update target */
#define PART_APP_START                     0x08008000UL
#define PART_APP_SIZE                      0x38000UL      /* 224 kB */
#define PART_APP_END                       0x08040000UL
#define PART_APP_INACTIVE_START            0x08048000UL   /* other bank, for update uploads */
#define PART_APP_INACTIVE_END              0x08080000UL

/* RAM */
#define RAM_START                          0x20000000UL
#define RAM_SIZE                           0x20000UL      /* 128 kB */

#endif /* MEMORY_MAP_H */
"
`;

