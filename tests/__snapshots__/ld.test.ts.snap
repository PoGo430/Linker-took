exports[`linker script generation > snapshots > MEMORY only, dual-bank, symbols > app.ld 1`] = `
"/*
 * Linker script for partition "app" — MEMORY block only (paste into your generated linker script)
 * Generated by Linker Partition Planner.
 * FLASH: 0x08000000, 0x80000 bytes = 512 kB, dual-bank (2 × 256 kB)
 * app: 0x08008000 .. 0x0803FFFF, 0x38000 bytes = 224 kB
 * Uses bank 1 addresses (the code runs here after a bank swap too).
 * Inactive bank copy for update uploads: 0x08048000 .. 0x0807FFFF
 */

MEMORY
{
  ROM (rx) : org = 0x08008000, len = 0x38000
  RAM (xrw) : org = 0x20000000, len = 0x20000
}

/* Partition symbols (usable from C via extern) */
PROVIDE(_bootloader_start = 0x08000000);
PROVIDE(_bootloader_size = 0x6000);
PROVIDE(_bootloader_end = 0x08006000);
PROVIDE(_header_start = 0x08006000);
PROVIDE(_header_size = 0x2000);
PROVIDE(_header_end = 0x08008000);
PROVIDE(_app_start = 0x08008000);
PROVIDE(_app_size = 0x38000);
PROVIDE(_app_end = 0x08040000);
"
`;

